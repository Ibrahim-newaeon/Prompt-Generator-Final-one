{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run build)",
      "Bash(bun run check)",
      "Bash(bun run dev)",
      "Bash(bun run lint)",
      "Bash(bun run preview)",
      "Bash(bun run db:generate)",
      "Bash(bun run db:migrate)",
      "Bash(bun run db:studio)",
      "Bash(bun run cf-typegen)",
      "Bash(bunx tsgo:*)",
      "Bash(bunx tsc --noEmit:*)",
      "Bash(bunx drizzle-kit generate)",
      "Bash(bunx drizzle-kit migrate)",
      "Bash(bunx drizzle-kit studio)",
      "Bash(bunx @better-auth/cli generate)",
      "Bash(bunx wrangler types)",
      "Bash(bunx wrangler deploy --dry-run)",
      "Bash(bunx wrangler d1 migrations apply DB --local)",
      "Bash(bunx wrangler d1 execute DB --local:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(bunx atmn push:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.dev.vars)",
      "Bash(bunx wrangler deploy)",
      "Bash(bunx wrangler d1 * --remote:*)",
      "Bash(bunx wrangler secret:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
